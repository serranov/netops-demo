# Copia este fichero a .env (esta ignorado por git) y ajusta:
#
# VM_IP: LO QUE ESCRIBES EN EL NAVEGADOR para llegar a la VM (Gitea construye sus enlaces con ello)
#   - localhost                si accedes por tunel SSH (demo/tunnel.sh)
#   - IP o nombre DNS de la VM si es alcanzable directamente (p.ej. 192.168.1.50 o vm.orb.local)
VM_IP=localhost

# NETOPS_PAT: token personal de Gitea con permiso repository: Read and Write.
#   Lo usa `make push` para abrir el Pull Request documentado por API, y `make secrets` lo
#   publica como secret NETOPS_PAT del repositorio netops-gitops para el pipeline.
#   (El nombre no puede empezar por GITEA_ ni GITHUB_: Gitea los reserva.)
NETOPS_PAT=
